"use strict";
var MIN_AGE = 18;
var MAX_AGE = 90;
var MIN_NAME_LENGTH = 4;
var MIN_POSITION_LENGTH = 4;
var TIMER = 3000;
var CITIES = [
    "Tokyo",
    "Singapore",
    "London",
    "New York",
    "Edinburgh",
    "San Francisco"
];
var thead = document.querySelector("thead");
var tbody = document.querySelector("tbody");
var lastSortedColomn = null;
var sortType = "asc";
thead.addEventListener("click", sortElements);
tbody.addEventListener("click", selectRow);
document.addEventListener("click", removeActive);
tbody.addEventListener("dblclick", editCell);
// sort rows
function sortElements(elem) {
    if (elem.target.tagName === "TH") {
        var colomnIndex = elem.target.cellIndex;
        if (colomnIndex === lastSortedColomn) sortType = sortType === "asc" ? "desc" : "asc";
        else sortType = "desc";
        lastSortedColomn = colomnIndex;
        var rows = Array.from(tbody.rows);
        var sort = rows.sort(function(row1, row2) {
            var cell1 = row1.cells[colomnIndex].textContent.trim();
            var cell2 = row2.cells[colomnIndex].textContent.trim();
            var sortResult = cell2.localeCompare(cell1, "uk", {
                numeric: true
            });
            return sortType === "asc" ? sortResult : -sortResult;
        });
        tbody.innerHTML = "";
        sort.forEach(function(row) {
            return tbody.appendChild(row);
        });
    }
}
// activete element
function selectRow(elem) {
    var activeRow = document.querySelector(".active");
    var clickedRow = elem.target.closest("tr");
    if (!clickedRow || !tbody.contains(clickedRow)) return;
    if (activeRow) activeRow.removeAttribute("class");
    clickedRow.classList.add("active");
}
function removeActive(elem) {
    var activeRow = document.querySelector(".active");
    var clickedRow = elem.target.closest("tr");
    if (!clickedRow && activeRow) activeRow.removeAttribute("class");
}
// edit cell
function editCell(elem) {
    var existValue = document.querySelector(".cell-input");
    if (existValue) finishEdit(existValue);
    var cell = elem.target;
    if (cell.tagName !== "TD") return;
    var originalInfo = cell.textContent.trim();
    var input = document.createElement("input");
    input.classList.add("cell-input");
    input.value = originalInfo;
    cell.textContent = "";
    cell.appendChild(input);
    input.focus();
    input.addEventListener("blur", function() {
        return finishEdit(input);
    });
    input.addEventListener("keypress", function(e) {
        if (e.key === "Enter") finishEdit(input);
    });
    function finishEdit(newInfo) {
        var newValue = newInfo.value.trim();
        cell.innerText = newValue || originalInfo;
    }
}
// notification
var pushNotification = function(title, description, type) {
    var div = document.createElement("div");
    div.setAttribute("data-qa", "notification");
    div.classList.add("notification", type);
    var h2 = document.createElement("h2");
    h2.textContent = title;
    h2.classList.add("title");
    var p = document.createElement("p");
    p.textContent = description;
    div.appendChild(h2);
    div.appendChild(p);
    document.body.appendChild(div);
    setTimeout(function() {
        return div.remove();
    }, TIMER);
};
var buttonExercise = function(elemForm) {
    elemForm.preventDefault();
    var form = document.getElementById("dynamicForm");
    var nameValue = form.elements["name"].value;
    var positionValue = form.elements["position"].value;
    var officeValue = form.elements["city"].value;
    var ageValue = Number(form.elements["age"].value);
    var salaryValue = Number(form.elements["salary"].value);
    if (!form.checkValidity()) {
        pushNotification("Error message", "Form cannot be empty.Please fill in all required fields!", "error");
        return;
    }
    if (nameValue.length < MIN_NAME_LENGTH) {
        pushNotification("Error message", "Name must be at least 4 characters long!", "error");
        return;
    }
    if (positionValue.length < MIN_POSITION_LENGTH) {
        pushNotification("Error message", "Position must be at least 4 characters long!Write right position!", "error");
        return;
    }
    if (ageValue < MIN_AGE || ageValue > MAX_AGE) {
        pushNotification("Error message", "Age must be between 18 and 90!", "error");
        return;
    }
    var newEmployee = CreateEmployee(nameValue, positionValue, officeValue, ageValue, salaryValue);
    pushNotification("Succes message", "Form submitted successfully!", "success");
    tbody.append(newEmployee);
    form.reset();
};
function CreateEmployee(employeName, position, office, age, salary) {
    var tableRow = document.createElement("tr");
    var formatSalary = salary.toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
    });
    var newEmployee = [
        employeName,
        position,
        office,
        age,
        formatSalary
    ];
    newEmployee.forEach(function(info) {
        var td = document.createElement("td");
        td.textContent = info;
        tableRow.appendChild(td);
    });
    return tableRow;
}
// create Form
function CreateForm() {
    var form = document.createElement("form");
    form.classList.add("new-employee-form");
    form.setAttribute("id", "dynamicForm");
    form.setAttribute("action", "/submit");
    form.setAttribute("method", "post");
    var officeLable = CreateLabel("Office: ", "office");
    var officeSelect = CreateSelect(CITIES, "office", "city");
    officeLable.append(officeSelect);
    var saveButton = CreateButton("dynamicForm", "Save to table");
    form.append(CreateElement("Name: ", "name", "text"));
    form.append(CreateElement("Position: ", "position", "text"));
    form.append(officeLable);
    form.append(CreateElement("Age: ", "age", "number"));
    form.append(CreateElement("Salary: ", "salary", "number"));
    form.append(saveButton);
    saveButton.addEventListener("click", buttonExercise);
    document.body.append(form);
}
function CreateElement(labelText, elementName, type) {
    var newLable = CreateLabel(labelText, elementName);
    var newInput = CreateInput(elementName, type);
    newLable.append(newInput);
    return newLable;
}
function CreateLabel(text, data) {
    var label = document.createElement("label");
    label.setAttribute("for", data);
    label.textContent = text;
    return label;
}
function CreateInput(inputName, inputType) {
    var input = document.createElement("input");
    input.setAttribute("name", inputName);
    input.setAttribute("data-qa", inputName);
    input.setAttribute("type", inputType);
    input.setAttribute("required", "");
    return input;
}
function CreateSelect(values, dataInput, selectName) {
    var select = document.createElement("select");
    select.setAttribute("name", selectName);
    select.setAttribute("data-qa", dataInput);
    values.forEach(function(value) {
        var option = document.createElement("option");
        option.textContent = value;
        option.value = value;
        select.append(option);
    });
    return select;
}
function CreateButton(fromId, text) {
    var button = document.createElement("button");
    button.setAttribute("type", "submit");
    button.setAttribute("form", fromId);
    button.textContent = text;
    return button;
}
CreateForm();

